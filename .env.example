ANTHROPIC_API_KEY=your_key_here
DB_PATH=data/stock_analyst.db
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-4-6
OPUS_MODEL=claude-opus-4-8
BRIEF_CRON=0 7 * * *
WATCHER_INTERVAL_MIN=15
# 선택: DART API 키 (https://opendart.fss.or.kr 무료 등록) → KR 재무제표(손익계산서·현금흐름) 활성화
DART_API_KEY=
# 선택: FRED API 키 (https://fred.stlouisfed.org/docs/api/api_key.html 무료 등록) → 미국 Fed금리·CPI·실업률 실데이터
FRED_API_KEY=
# 선택: 한국은행 ECOS API 키 (https://ecos.bok.or.kr/#/AuthKeyApply 무료 등록) → 한국 기준금리·CPI 실데이터
ECOS_API_KEY=
